#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = "C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" --regenerate-during-build -S"D:\PersonalProject\RTOS_Scheduler\RTOS Scheduler" -B"D:\PersonalProject\RTOS_Scheduler\RTOS Scheduler\out\build\x64-Debug"
  description = Re-running CMake...
  generator = 1


#############################################
